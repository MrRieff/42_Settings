alias git_update='cd ~/Desktop && rm -rf Github && git clone git@github.com:MrRieff/42.git Github && cd Github'
alias mini_update='cd ~/Desktop && rm -rf Minishell && git clone git@github.com:MrRieff/Minishell.git Minishell && cd Minishell && cursor .'


alias update_pa='cd ~/Desktop && rm -rf ParkingAid && mkdir ParkingAid && cd ParkingAid && git clone git@github.com:ParkingAid/parkingaidcrm.git CRM && git clone git@github.com:ParkingAid/parkingaid-worldwide.git APP && git clone git@github.com:ParkingAid/traffic-platform.git TRAFFIC'

alias update_crm='cd ~/Desktop/ParkingAid && rm -rf CRM && git clone git@github.com:ParkingAid/parkingaidcrm.git CRM && cd CRM && cursor .'

alias update_app='cd ~/Desktop/ParkingAid && rm -rf APP && git clone git@github.com:ParkingAid/parkingaid-worldwide.git APP && cd APP && cursor .'

alias update_traffic='cd ~/Desktop/ParkingAid && rm -rf Traffic && git clone git@github.com:ParkingAidAB/trafficplatform-temp.git Traffic && cd Traffic && cursor .'

alias parkingaid='cd ~/Desktop/Parkingaid'

alias traffic='parkingaid && cd Traffic'

alias serve='supabase functions serve --env-file ./supabase/.env'
