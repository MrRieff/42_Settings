#SETTINGS FOR PATHS AND SOURCES

#-----------Edit--------------
alias edit_path='vim ~/.settings/Alias/.bash_alias'
alias update_path='source ~/.settings/Alias/.bash_alias'

alias edit_alias='vim ~/.settings/Alias/.alias'
alias update_alias='source ~/.settings/Alias/.alias'

alias edit_library='vim ~/.settings/Alias/.libraries'
alias update_library='source ~/.settings/Alias/.libraries'

alias edit_zsh='vim ~/.zshrc'
alias update_zsh='source ~/.zshrc'

#-----------PATHS-------------
source ~/.settings/Alias/.alias
source ~/.settings/Alias/.libraries

