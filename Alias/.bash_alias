#SETTINGS FOR PATHS AND SOURCES

#-----------Edit--------------
alias edit_path='vim ~/Desktop/.settings/Alias/.bash_alias'
alias update_path='source ~/Desktop/42/Settings/Alias/.bash_alias'

alias edit_alias='vim ~/Desktop/.settings/Alias/.alias'
alias update_alias='source ~/Desktop/.settings/Alias/.alias'

alias edit_library='vim ~/Desktop/.settings/Alias/.libraries'
alias update_library='source ~/Desktop/.settings/Alias/.libraries'

alias edit_zh='vim ~/.zshrc'
alias update_zh='source ~/.zshrc'

#-----------PATHS-------------
source ~/Desktop/.settings/Alias/.alias
source ~/Desktop/.settings/Alias/.libraries

#----------Scripts------------
source ~/Desktop/.settings/Scripts/MakefileRunner.sh
#source ~/Desktop/42/Settings/Scripts/findopen_mac

if [ -f ~/Desktop/42/Settings/Alias/.alias ]; then
. ~/Desktop/.settings/Alias/.alias
fi

